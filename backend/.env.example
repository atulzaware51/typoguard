# Required only for POST /api/domains/import. Replace with a strong random value.
TYPOGUARD_ADMIN_SECRET=replace-with-a-strong-random-secret

# Comma-separated exact browser origins; do not use a wildcard in production.
TYPOGUARD_CORS_ORIGINS=https://your-frontend.example

# Optional. On Render, set this to a file inside the persistent disk mount.
# Example when the disk mount path is /var/data:
# TYPOGUARD_SQLITE_PATH=/var/data/typoguard.db
